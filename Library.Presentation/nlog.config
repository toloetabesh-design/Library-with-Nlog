<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<!-- اضافه کردن قابلیت Async برای جلوگیری از کندی برنامه -->
	<targets async="true">

		<!-- تنظیمات هدف دیتابیس -->
		<target xsi:type="Database"
				name="databaseTarget"
				dbProvider="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient"
				connectionString="Server=YOUR_SERVER;Database=LibraryDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;">

			<!-- دستور SQL برای درج لاگ -->
			<commandText>
				INSERT INTO LogTable (TimeStamp, LogLevel, Message, Exception, Logger)
				VALUES (@time, @level, @msg, @ex, @logger);
			</commandText>

			<!-- تعریف پارامترها برای جایگذاری در دستور SQL -->
			<parameter name="@time" layout="${date}" />
			<parameter name="@level" layout="${level}" />
			<parameter name="@msg" layout="${message}" />
			<parameter name="@ex" layout="${exception:format=tostring}" />
			<parameter name="@logger" layout="${logger}" />
		</target>

		<!-- تنظیم هدف فایل (همزمان هم در فایل ذخیره کن هم در دیتابیس) -->
		<target xsi:type="File" name="fileTarget" fileName="logs/app-log.txt" />
	</targets>

	<rules>
		<!-- تمام لاگ‌ها را هم در فایل و هم در دیتابیس بنویس -->
		<logger name="*" minlevel="Info" writeTo="fileTarget,databaseTarget" />
	</rules>
</nlog>
